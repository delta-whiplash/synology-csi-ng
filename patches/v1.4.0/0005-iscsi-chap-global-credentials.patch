+++ b/pkg/dsm/webapi/iscsi_create_auth_test.go
@@ -0,0 +1,169 @@
+// Copyright 2026 Synology Inc.
+
+package webapi
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+)
+
+const testPassword = "p@ss&word=test+123"
+
+// capturedTargetCreate records what TargetCreate sent to the fake DSM.
+type capturedTargetCreate struct {
+	method   string
+	rawQuery string
+	params   url.Values
+}
+
+func newTargetCreateServer(t *testing.T, captured *capturedTargetCreate) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		captured.method = r.Method
+		captured.rawQuery = r.URL.RawQuery
+		if err := r.ParseForm(); err == nil {
+			captured.params = r.Form
+		} else {
+			captured.params = r.URL.Query()
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"success":true,"data":{"target_id":7}}`))
+	}))
+}
+
+// TestTargetCreate_WithoutChap: absent CHAP keys keep the upstream behavior
+// exactly — a plain GET, auth_type=0, no credential params at all.
+func newTestDsmForServer(t *testing.T, server *httptest.Server) *DSM {
+	t.Helper()
+	host, port := serverHostPort(t, server)
+	return &DSM{
+		Ip:       host,
+		Port:     port,
+		Username: "admin",
+		Password: "secret",
+		Https:    false,
+		Sid:      "test-sid",
+	}
+}
+
+func TestTargetCreate_WithoutChap(t *testing.T) {
+	var got capturedTargetCreate
+	server := newTargetCreateServer(t, &got)
+	defer server.Close()
+
+	dsm := newTestDsmForServer(t, server)
+
+	id, err := dsm.TargetCreate(TargetCreateSpec{Name: "csi-test", Iqn: "iqn.2026-01.test:c1"})
+	if err != nil {
+		t.Fatalf("TargetCreate returned error: %v", err)
+	}
+	if id != "7" {
+		t.Errorf("TargetCreate returned id %q, want %q", id, "7")
+	}
+
+	if got.method != http.MethodGet {
+		t.Errorf("method = %q, want GET when CHAP is not configured", got.method)
+	}
+	if got := got.params.Get("api"); got != "SYNO.Core.ISCSI.Target" {
+		t.Errorf("api = %q, want %q", got, "SYNO.Core.ISCSI.Target")
+	}
+	if got := got.params.Get("auth_type"); got != "0" {
+		t.Errorf("auth_type = %q, want %q (no CHAP configured)", got, "0")
+	}
+	if got := got.params.Get("user"); got != "" {
+		t.Errorf("user = %q, want empty when CHAP is not configured", got)
+	}
+	if got := got.params.Get("password"); got != "" {
+		t.Errorf("password = %q, want empty when CHAP is not configured", got)
+	}
+}
+
+// TestTargetCreate_WithChap: configured CHAP creates the target with
+// auth_type=1, and the credentials must travel in the POST body — never in
+// the URL query string, which the debug log (and access logs) retain.
+func TestTargetCreate_WithChap(t *testing.T) {
+	var got capturedTargetCreate
+	server := newTargetCreateServer(t, &got)
+	defer server.Close()
+
+	dsm := newTestDsmForServer(t, server)
+	dsm.IscsiUser = "k8s-worker"
+	dsm.IscsiPass = testPassword
+
+	id, err := dsm.TargetCreate(TargetCreateSpec{Name: "csi-test", Iqn: "iqn.2026-01.test:c2"})
+	if err != nil {
+		t.Fatalf("TargetCreate returned error: %v", err)
+	}
+	if id != "7" {
+		t.Errorf("TargetCreate returned id %q, want %q", id, "7")
+	}
+
+	if got.method != http.MethodPost {
+		t.Errorf("method = %q, want POST so the credentials ride in the body, not the URL", got.method)
+	}
+	if got.rawQuery != "" {
+		t.Errorf("URL query string = %q, want empty: nothing secret may stay in the request line", got.rawQuery)
+	}
+	if strings.Contains(got.rawQuery, testPassword) {
+		t.Fatalf("the CHAP password leaked into the URL query string: %q", got.rawQuery)
+	}
+
+	if got := got.params.Get("auth_type"); got != "1" {
+		t.Errorf("auth_type = %q, want %q (CHAP configured)", got, "1")
+	}
+	if got := got.params.Get("user"); got != "k8s-worker" {
+		t.Errorf("user = %q, want %q", got, "k8s-worker")
+	}
+	if got := got.params.Get("password"); got != testPassword {
+		t.Errorf("password = %q, want %q (special characters must survive encoding)", got, testPassword)
+	}
+}
+
+// TestTargetCreate_PartialChapIgnored: a half-configured pair must fall back
+// to no auth rather than creating targets that demand CHAP nobody can pass.
+func TestTargetCreate_PartialChapIgnored(t *testing.T) {
+	var got capturedTargetCreate
+	server := newTargetCreateServer(t, &got)
+	defer server.Close()
+
+	dsm := newTestDsmForServer(t, server)
+	dsm.IscsiUser = "k8s-worker" // user set, password missing: must NOT enable CHAP
+
+	if _, err := dsm.TargetCreate(TargetCreateSpec{Name: "csi-test", Iqn: "iqn.2026-01.test:c3"}); err != nil {
+		t.Fatalf("TargetCreate returned error: %v", err)
+	}
+
+	if got := got.params.Get("auth_type"); got != "0" {
+		t.Errorf("auth_type = %q, want %q (partial CHAP config must fall back to no-auth)", got, "0")
+	}
+	if got := got.params.Get("user"); got != "" {
+		t.Errorf("user = %q, want empty when CHAP is partially configured", got)
+	}
+}
+
+// TestRedactSecrets_MasksChapFields: the debug log of every webapi call runs
+// through redactSecrets; it must mask the CHAP password fields, not only the
+// DSM login password.
+func TestRedactSecrets_MasksChapFields(t *testing.T) {
+	in := "api=SYNO.Core.ISCSI.Target&method=create&user=k8s-worker&password=sekret-a&chap_pass=sekret-b&passwd=sekret-c&iqn=iqn.2026-01.test:c1"
+	got := redactSecrets(in)
+
+	for _, secret := range []string{"sekret-a", "sekret-b", "sekret-c"} {
+		if strings.Contains(got, secret) {
+			t.Errorf("redactSecrets(%q) still contains %q", in, secret)
+		}
+	}
+	for _, redacted := range []string{"password=[REDACTED]", "chap_pass=[REDACTED]", "passwd=[REDACTED]"} {
+		if !strings.Contains(got, redacted) {
+			t.Errorf("redactSecrets(%q) missing %q, got %q", in, redacted, got)
+		}
+	}
+	for _, kept := range []string{"user=k8s-worker", "iqn=iqn.2026-01.test:c1"} {
+		if !strings.Contains(got, kept) {
+			t.Errorf("redactSecrets(%q) should keep %q, got %q", in, kept, got)
+		}
+	}
+}

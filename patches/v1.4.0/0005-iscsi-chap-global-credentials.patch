+// Copyright 2026 Synology Inc.
+
+package webapi
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+)
+
+func newTargetCreateServer(t *testing.T, captured *url.Values) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if err := r.ParseForm(); err == nil {
+			*captured = r.Form
+		} else {
+			*captured = r.URL.Query()
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"success":true,"data":{"target_id":7}}`))
+	}))
+}
+
+func TestTargetCreate_WithoutChap(t *testing.T) {
+	var gotParams url.Values
+	server := newTargetCreateServer(t, &gotParams)
+	defer server.Close()
+
+	host, port := serverHostPort(t, server)
+	dsm := &DSM{
+		Ip:       host,
+		Port:     port,
+		Username: "admin",
+		Password: "secret",
+		Https:    false,
+		Sid:      "test-sid",
+	}
+
+	id, err := dsm.TargetCreate(TargetCreateSpec{Name: "csi-test", Iqn: "iqn.2026-01.test:c1"})
+	if err != nil {
+		t.Fatalf("TargetCreate returned error: %v", err)
+	}
+	if id != "7" {
+		t.Errorf("TargetCreate returned id %q, want %q", id, "7")
+	}
+
+	if got := gotParams.Get("api"); got != "SYNO.Core.ISCSI.Target" {
+		t.Errorf("api = %q, want %q", got, "SYNO.Core.ISCSI.Target")
+	}
+	if got := gotParams.Get("auth_type"); got != "0" {
+		t.Errorf("auth_type = %q, want %q (no CHAP configured)", got, "0")
+	}
+	if got := gotParams.Get("user"); got != "" {
+		t.Errorf("user = %q, want empty when CHAP is not configured", got)
+	}
+	if got := gotParams.Get("password"); got != "" {
+		t.Errorf("password = %q, want empty when CHAP is not configured", got)
+	}
+}
+
+func TestTargetCreate_WithChap(t *testing.T) {
+	var gotParams url.Values
+	server := newTargetCreateServer(t, &gotParams)
+	defer server.Close()
+
+	host, port := serverHostPort(t, server)
+	dsm := &DSM{
+		Ip:       host,
+		Port:     port,
+		Username: "admin",
+		Password: "secret",
+		Https:    false,
+		Sid:      "test-sid",
+		IscsiUser: "k8s-worker",
+		IscsiPass: "p@ss&word=test+123",
+	}
+
+	id, err := dsm.TargetCreate(TargetCreateSpec{Name: "csi-test", Iqn: "iqn.2026-01.test:c2"})
+	if err != nil {
+		t.Fatalf("TargetCreate returned error: %v", err)
+	}
+	if id != "7" {
+		t.Errorf("TargetCreate returned id %q, want %q", id, "7")
+	}
+
+	if got := gotParams.Get("auth_type"); got != "1" {
+		t.Errorf("auth_type = %q, want %q (CHAP configured)", got, "1")
+	}
+	if got := gotParams.Get("user"); got != "k8s-worker" {
+		t.Errorf("user = %q, want %q", got, "k8s-worker")
+	}
+	if got := gotParams.Get("password"); got != "p@ss&word=test+123" {
+		t.Errorf("password = %q, want %q (special characters must survive URL encoding)", got, "p@ss&word=test+123")
+	}
+}
+
+func TestTargetCreate_PartialChapIgnored(t *testing.T) {
+	var gotParams url.Values
+	server := newTargetCreateServer(t, &gotParams)
+	defer server.Close()
+
+	host, port := serverHostPort(t, server)
+	dsm := &DSM{
+		Ip:        host,
+		Port:      port,
+		Username:  "admin",
+		Password:  "secret",
+		Https:     false,
+		Sid:       "test-sid",
+		IscsiUser: "k8s-worker", // user set, password missing: must NOT enable CHAP
+	}
+
+	if _, err := dsm.TargetCreate(TargetCreateSpec{Name: "csi-test", Iqn: "iqn.2026-01.test:c3"}); err != nil {
+		t.Fatalf("TargetCreate returned error: %v", err)
+	}
+
+	if got := gotParams.Get("auth_type"); got != "0" {
+		t.Errorf("auth_type = %q, want %q (partial CHAP config must fall back to no-auth)", got, "0")
+	}
+	if got := gotParams.Get("user"); got != "" {
+		t.Errorf("user = %q, want empty when CHAP is partially configured", got)
+	}
+}

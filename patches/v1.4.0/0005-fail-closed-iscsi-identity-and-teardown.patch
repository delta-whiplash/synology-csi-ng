+		VolumeId:   "8029e1d2-8ea8-4e8a-ae5f-e4b9404885fa",
+		TargetPath: filepath.Join(t.TempDir(), "absent"),
+	}); err != nil {
+		t.Fatalf("unpublish of an absent target must succeed, got: %v", err)
+	}
+}

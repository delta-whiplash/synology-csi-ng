+// iscsiadm_set_node_auth stores the CHAP credentials the initiator must
+// present when logging in to a target that demands CHAP (DSM target
+// auth_type=1). Without this the login is refused even though the target
+// exists — the target-side and initiator-side halves of CHAP are separate.
+func (t *tools) iscsiadm_set_node_auth(iqn, portal, chapUser, chapPass string) error {
+	cmd := t.iscsiadm(
+		"-m", "node",
+		"--targetname", iqn,
+		"--portal", portal,
+		"--op", "update",
+		"--name", "node.session.auth.authmethod", "--value", "CHAP",
+		"--name", "node.session.auth.username", "--value", chapUser,
+		"--name", "node.session.auth.password", "--value", chapPass)
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("%s (%v)", string(out), err)
+	}
+	return nil
+}

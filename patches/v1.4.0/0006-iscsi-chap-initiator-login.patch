diff --git a/pkg/driver/iscsi_chap_login_test.go b/pkg/driver/iscsi_chap_login_test.go
new file mode 100644
index 0000000..393c166
--- /dev/null
+++ b/pkg/driver/iscsi_chap_login_test.go
@@ -0,0 +1,79 @@
+// Copyright 2026 Synology Inc.
+
+package driver
+
+import (
+	"strings"
+	"testing"
+)
+
+// TestLoginConfiguresChapOnTheNodeRecord: a target created with auth_type=1
+// refuses a plain login. When CHAP credentials are configured for the DSM,
+// the node record must be updated with them before the login attempt — and
+// only then.
+func TestLoginConfiguresChapOnTheNodeRecord(t *testing.T) {
+	e := &recordingExecutor{} // no sessions: a fresh login
+	d := newTestInitiator(e)
+
+	if err := d.login(testIqn, testPortal, "k8s-worker", "some-pass"); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	authIdx := e.find("node.session.auth.authmethod")
+	if authIdx < 0 {
+		t.Fatalf("expected the node record to be configured for CHAP, ran: %v", e.ran)
+	}
+	for _, want := range []string{
+		"node.session.auth.authmethod --value CHAP",
+		"node.session.auth.username --value k8s-worker",
+		"node.session.auth.password --value some-pass",
+	} {
+		if !strings.Contains(e.ran[authIdx], want) {
+			t.Errorf("auth update %q is missing %q", e.ran[authIdx], want)
+		}
+	}
+	// CHAP must be configured after discovery (the record is created by it)
+	// and before the login attempt.
+	discIdx := e.find("--discover")
+	loginIdx := e.find("--login")
+	if discIdx < 0 || loginIdx < 0 {
+		t.Fatalf("expected discovery and login, ran: %v", e.ran)
+	}
+	if authIdx < discIdx || authIdx > loginIdx {
+		t.Errorf("auth update at %d must sit between discovery (%d) and login (%d), ran: %v",
+			authIdx, discIdx, loginIdx, e.ran)
+	}
+}
+
+// TestLoginWithoutChapKeepsThePlainLogin: no CHAP credentials means the
+// upstream login flow, untouched — no auth update at all.
+func TestLoginWithoutChapKeepsThePlainLogin(t *testing.T) {
+	e := &recordingExecutor{} // no sessions: a fresh login
+	d := newTestInitiator(e)
+
+	if err := d.login(testIqn, testPortal, "", ""); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if idx := e.find("node.session.auth"); idx >= 0 {
+		t.Errorf("did not expect any auth update without CHAP credentials, ran: %v", e.ran)
+	}
+	if e.find("--login") < 0 {
+		t.Errorf("expected the plain login to still happen, ran: %v", e.ran)
+	}
+}
+
+// TestLoginFailsWhenChapCannotBeStored: a target that demands CHAP must not
+// be logged in to without the credentials — a failed auth update aborts the
+// login instead of attempting one that DSM would reject.
+func TestLoginFailsWhenChapCannotBeStored(t *testing.T) {
+	e := &recordingExecutor{fail: "node.session.auth"}
+	d := newTestInitiator(e)
+
+	if err := d.login(testIqn, testPortal, "k8s-worker", "some-pass"); err == nil {
+		t.Fatal("expected an error when the CHAP credentials cannot be stored")
+	}
+	if e.find("--login") >= 0 {
+		t.Errorf("did not expect a login attempt after a failed auth update, ran: %v", e.ran)
+	}
+}

+
+// detachHost keeps a simple mutable host table understood by the tests.
+// Unmounting an alias or a raw path that the table lists (same mount object
+// reached through a different name) removes it -- what the real kernel does.
+func detachHost(tbl *[]mount.MountPoint, requested string) {
+	plain := strings.TrimPrefix(requested, hostRootAlias)
+	kept := (*tbl)[:0]
+	for _, mp := range *tbl {
+		if mp.Path == plain || mp.Path == requested {
+			continue
+		}
+		kept = append(kept, mp)
+	}
+	*tbl = kept
+}
+
+// withHostViewFakes overrides both mount-table seams for one test and
+// restores them afterwards. views("host") backs /host/proc/mounts reads,
+// views("container") backs /proc/mounts reads.
+func withHostViewFakes(t *testing.T, hostFile string, views func(which string) ([]mount.MountPoint, error)) {
+	t.Helper()
+	listProcMounts = func(path string) ([]mount.MountPoint, error) {
+		if path == hostMountsFile {
+			return views("host")
+		}
+		return views("container")
+	}
+	hostMountsFile = hostFile
+	t.Cleanup(func() {
+		listProcMounts = mount.ListProcMounts
+		hostMountsFile = "/host/proc/mounts"
+	})
+}
+
+// TestNodeUnpublishUnmountsThroughHostAlias reproduces the 2026-10-21 zombie:
+// the volume mount is alive on the host and absent from the container's own
+// mount table, so the plain peel was a no-op, os.Remove tripped with EBUSY
+// and kubelet called NodeUnpublishVolume forever. The mount must be
+// unmounted through its /host alias, verified against the host table, and
+// the target path removed.
+func TestNodeUnpublishUnmountsThroughHostAlias(t *testing.T) {
+	target := filepath.Join(t.TempDir(), "pods", "uid-1", "volumes", "kubernetes.io~csi", "pvc-dead", "mount")
+	if err := os.MkdirAll(target, 0o750); err != nil {
+		t.Fatal(err)
+	}
+	hostTable := []mount.MountPoint{{Device: "/dev/sdc", Path: target, Opts: []string{"rw"}}}
+	alias := hostRootAlias + target
+
+	withHostViewFakes(t, "/host/proc/mounts-fake", func(which string) ([]mount.MountPoint, error) {
+		if which == "host" {
+			return hostTable, nil
+		}
+		// The container view is blind: it renders the mount only under the
+		// /host path, which NodeUnpublish never names.
+		return nil, nil
+	})
+
+	fm := mount.NewFakeMounter([]mount.MountPoint{{Device: "/dev/sdc", Path: alias, Opts: []string{"rw"}}})
+	var unmountCalls []string
+	fm.UnmountFunc = func(mounted string) error {
+		unmountCalls = append(unmountCalls, mounted)
+		detachHost(&hostTable, mounted)
+		return nil
+	}
+
+	ns := &nodeServer{Mounter: &mount.SafeFormatAndMount{Interface: fm}}
+	if _, err := ns.NodeUnpublishVolume(context.Background(), &csi.NodeUnpublishVolumeRequest{VolumeId: "vol-1", TargetPath: target}); err != nil {
+		t.Fatalf("NodeUnpublishVolume: %v", err)
+	}
+
+	if len(unmountCalls) != 1 || unmountCalls[0] != alias {
+		t.Fatalf("unmount calls = %v, want exactly the host alias %s", unmountCalls, alias)
+	}
+	if _, err := os.Stat(target); !os.IsNotExist(err) {
+		t.Errorf("targetPath %s still exists after the alias unmount", target)
+	}
+}
+
+// TestNodeUnpublishRefusesWhileHostViewStillMounted mirrors the 0005
+// fail-closed rule on the new view: an unmount that did not detach (kernel
+// keeps the mount alive) is an error, never a success -- kubelet retries,
+// the lie is what wedged volumesInUse forever in the original incident.
+func TestNodeUnpublishRefusesWhileHostViewStillMounted(t *testing.T) {
+	target := filepath.Join(t.TempDir(), "mount")
+	if err := os.MkdirAll(target, 0o750); err != nil {
+		t.Fatal(err)
+	}
+	hostTable := []mount.MountPoint{{Device: "/dev/sdc", Path: target, Opts: []string{"rw"}}}
+
+	withHostViewFakes(t, "/host/proc/mounts-fake", func(which string) ([]mount.MountPoint, error) {
+		if which == "host" {
+			return hostTable, nil
+		}
+		return nil, nil
+	})
+
+	fm := mount.NewFakeMounter([]mount.MountPoint{{Device: "/dev/sdc", Path: hostRootAlias + target, Opts: []string{"rw"}}})
+	var unmountCalls []string
+	fm.UnmountFunc = func(mounted string) error {
+		unmountCalls = append(unmountCalls, mounted)
+		// The kernel refuses to detach this one: both the fake Mounter and
+		// the host table keep the mount alive.
+		fm.MountPoints = append(fm.MountPoints, mount.MountPoint{Device: "/dev/sdc", Path: mounted, Opts: []string{"rw"}})
+		return nil
+	}
+
+	ns := &nodeServer{Mounter: &mount.SafeFormatAndMount{Interface: fm}}
+	_, err := ns.NodeUnpublishVolume(context.Background(), &csi.NodeUnpublishVolumeRequest{VolumeId: "vol-1", TargetPath: target})
+	if err == nil {
+		t.Fatal("NodeUnpublishVolume reported success while the host view still holds the mount")
+	}
+	if !strings.Contains(err.Error(), "still mounted in the host view after") {
+		t.Errorf("error should name the unresolved host view, got: %v", err)
+	}
+	// The peel stays bounded: at least one attempt, never more than the
+	// peel bound (the fake mounter consumed the alias entry on the first
+	// Unmount, so re-attempts happen through its bookkeeping, not the
+	// callback).
+	if len(unmountCalls) < 1 || len(unmountCalls) > maxUnmountPeels {
+		t.Errorf("expected 1..%d bounded alias attempts, got %d (%v)", maxUnmountPeels, len(unmountCalls), unmountCalls)
+	}
+
+	// The target directory must survive: success was not reported, and the
+	// kubelet will keep retrying.
+	if _, statErr := os.Stat(target); statErr != nil {
+		t.Errorf("targetPath must survive a failed unpublish: %v", statErr)
+	}
+}
+
+// TestNodeUnpublishSweepsHostViewSubMounts checks the second view gets the
+// same sub-mount sweep: deepest first, through aliases, before the parent.
+func TestNodeUnpublishSweepsHostViewSubMounts(t *testing.T) {
+	target := filepath.Join(t.TempDir(), "mount")
+	shallow := filepath.Join(target, "a")
+	deep := filepath.Join(target, "a", "b")
+	for _, d := range []string{deep, target} {
+		if err := os.MkdirAll(d, 0o750); err != nil {
+			t.Fatal(err)
+		}
+	}
+	hostTable := []mount.MountPoint{
+		{Device: "/dev/sdd", Path: shallow, Opts: []string{"rw"}},
+		{Device: "/dev/sde", Path: deep, Opts: []string{"rw"}},
+		{Device: "/dev/sdc", Path: target, Opts: []string{"rw"}},
+	}
+
+	withHostViewFakes(t, "/host/proc/mounts-fake", func(which string) ([]mount.MountPoint, error) {
+		if which == "host" {
+			return hostTable, nil
+		}
+		return nil, nil
+	})
+
+	fm := mount.NewFakeMounter([]mount.MountPoint{
+		{Device: "/dev/sde", Path: hostRootAlias + deep, Opts: []string{"rw"}},
+		{Device: "/dev/sdd", Path: hostRootAlias + shallow, Opts: []string{"rw"}},
+		{Device: "/dev/sdc", Path: hostRootAlias + target, Opts: []string{"rw"}},
+	})
+	var unmountCalls []string
+	fm.UnmountFunc = func(mounted string) error {
+		unmountCalls = append(unmountCalls, mounted)
+		detachHost(&hostTable, mounted)
+		return nil
+	}
+
+	ns := &nodeServer{Mounter: &mount.SafeFormatAndMount{Interface: fm}}
+	if _, err := ns.NodeUnpublishVolume(context.Background(), &csi.NodeUnpublishVolumeRequest{VolumeId: "vol-1", TargetPath: target}); err != nil {
+		t.Fatalf("NodeUnpublishVolume: %v", err)
+	}
+
+	want := []string{
+		hostRootAlias + deep,    // deepest first
+		hostRootAlias + shallow, // then the shallow sub-mount
+		hostRootAlias + target,  // then the target itself
+	}
+	if len(unmountCalls) != len(want) {
+		t.Fatalf("unmount calls = %v, want %v", unmountCalls, want)
+	}
+	for i, w := range want {
+		if unmountCalls[i] != w {
+			t.Errorf("call %d = %s, want %s", i, unmountCalls[i], w)
+		}
+	}
+	if _, err := os.Stat(target); !os.IsNotExist(err) {
+		t.Errorf("targetPath %s still exists after the sweep", target)
+	}
+}
+
+// TestNodeUnpublishDedupesSharedSubMounts annotates the case the /host
+// alias patch must not break: a mount visible in BOTH tables is the same
+// mount object -- the container sweep unmounts it once with its plain path
+// and the host sweep must not try to detach it again through the alias.
+func TestNodeUnpublishDedupesSharedSubMounts(t *testing.T) {
+	target := filepath.Join(t.TempDir(), "mount")
+	sub := filepath.Join(target, "sub")
+	if err := os.MkdirAll(sub, 0o750); err != nil {
+		t.Fatal(err)
+	}
+	hostTable := []mount.MountPoint{
+		{Device: "/dev/sda", Path: sub, Opts: []string{"rw"}},
+		{Device: "/dev/sdc", Path: target, Opts: []string{"rw"}},
+	}
+
+	withHostViewFakes(t, "/host/proc/mounts-fake", func(which string) ([]mount.MountPoint, error) {
+		if which == "host" {
+			return hostTable, nil
+		}
+		// The container view sees the same mounts at the same paths.
+		return hostTable, nil
+	})
+
+	fm := mount.NewFakeMounter(hostTable)
+	var unmountCalls []string
+	fm.UnmountFunc = func(mounted string) error {
+		unmountCalls = append(unmountCalls, mounted)
+		detachHost(&hostTable, mounted)
+		return nil
+	}
+
+	ns := &nodeServer{Mounter: &mount.SafeFormatAndMount{Interface: fm}}
+	if _, err := ns.NodeUnpublishVolume(context.Background(), &csi.NodeUnpublishVolumeRequest{VolumeId: "vol-1", TargetPath: target}); err != nil {
+		t.Fatalf("NodeUnpublishVolume: %v", err)
+	}
+
+	var sawAlias bool
+	for _, c := range unmountCalls {
+		if strings.HasPrefix(c, hostRootAlias) {
+			sawAlias = true
+		}
+	}
+	if len(unmountCalls) != 2 || sawAlias {
+		t.Errorf("a mount present in both views must be unmounted once through its plain path "+
+			"(sub first, then target); calls = %v", unmountCalls)
+	}
+	if unmountCalls[0] != sub {
+		t.Errorf("first unmount = %s, want the shared sub-mount %s", unmountCalls[0], sub)
+	}
+}
+
+// TestNodeUnpublishPreservesOldBehaviorWithoutHostTable: a deployment that
+// does not provide the /host bind (or a host table read error) must leave
+// the container-only path working exactly as before.
+func TestNodeUnpublishPreservesOldBehaviorWithoutHostTable(t *testing.T) {
+	target := filepath.Join(t.TempDir(), "mount")
+	if err := os.MkdirAll(target, 0o750); err != nil {
+		t.Fatal(err)
+	}
+
+	fm := mount.NewFakeMounter([]mount.MountPoint{{Device: "/dev/sdc", Path: target, Opts: []string{"rw"}}})
+	withHostViewFakes(t, filepath.Join(t.TempDir(), "absent-mutations"), func(which string) ([]mount.MountPoint, error) {
+		if which == "host" {
+			return nil, fmt.Errorf("/host not bound in this deployment")
+		}
+		// The container view works normally and shows the live table.
+		return fm.List()
+	})
+
+	var unmountCalls []string
+	fm.UnmountFunc = func(mounted string) error {
+		unmountCalls = append(unmountCalls, mounted)
+		return nil
+	}
+
+	ns := &nodeServer{Mounter: &mount.SafeFormatAndMount{Interface: fm}}
+	if _, err := ns.NodeUnpublishVolume(context.Background(), &csi.NodeUnpublishVolumeRequest{VolumeId: "vol-1", TargetPath: target}); err != nil {
+		t.Fatalf("NodeUnpublishVolume: %v", err)
+	}
+	if len(unmountCalls) != 1 || unmountCalls[0] != target {
+		t.Errorf("unmount calls = %v, want the plain container-side unmount only", unmountCalls)
+	}
+}

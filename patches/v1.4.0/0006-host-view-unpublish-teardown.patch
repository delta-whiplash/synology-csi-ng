+// The plugin container does not share the host mount namespace. A mount can
+// therefore be alive on the host while the container's own /proc/mounts does
+// not render its kubelet path at all -- observed 2026-10-21, where a pod
+// that died mid-purge left its volume mount in exactly that state: the
+// kubelet kept calling NodeUnpublishVolume on
+// /var/lib/kubelet/pods/<uid>/volumes/.../mount, the container view showed
+// the mount only under the /host bind, every plain unmount was a silent
+// no-op (the path it named was not a mountpoint anywhere the container could
+// see), os.Remove tripped over the live mount with EBUSY and the cleanup
+// loop never converged until the mount was unmounted through its /host
+// alias.
+//
+// The DaemonSet already binds the host root at /host, so the host kernel's
+// own table is readable at /host/proc/mounts and every host path is
+// reachable at /host/<path>. The helpers below use that second view to
+// detect and tear down mounts the container view lost. When the host table
+// cannot be read (deployment without the /host bind, sandbox, transient
+// error) the helpers no-op and the container-only behavior is preserved.
+
+// hostMountsFile is the path from which the host kernel's mount table is
+// read through the DaemonSet's bind of the host root. Empty disables the
+// second view entirely. Var so tests can point it at a fake table.
+var hostMountsFile = "/host/proc/mounts"
+
+// hostRootAlias is the in-container prefix at which the host root is bound.
+var hostRootAlias = "/host"
+
+// hostViewMounts returns the host table read through the /host bind, and
+// whether it was readable at all. Best effort by design: an unreadable host
+// table must never fail paths the container view already handled.
+func hostViewMounts() ([]mount.MountPoint, bool) {
+	if hostMountsFile == "" {
+		return nil, false
+	}
+	mounts, err := listProcMounts(hostMountsFile)
+	if err != nil {
+		return nil, false
+	}
+	return mounts, true
+}
+
+// stillMountedInHostView reports whether the host kernel currently carries a
+// mount at the exact path. The host table records resolved dentry paths, so
+// an exact match against the path kubelet published (the host-side path) is
+// authoritative. ok=false means the host view is unavailable.
+func stillMountedInHostView(path string) (bool, bool) {
+	mounts, ok := hostViewMounts()
+	if !ok {
+		return false, false
+	}
+	for _, mp := range mounts {
+		if mp.Path == path {
+			return true, true
+		}
+	}
+	return false, true
+}
+
+// hostPathAlias returns the in-container path at which a mount living on the
+// host tree is reachable: hostPathAlias("/var/lib/kubelet/u/m") names
+// /host/var/lib/kubelet/u/m inside the container. Unmounting that alias
+// detaches the same mount object the host path names.
+func hostPathAlias(path string) string {
+	return hostRootAlias + path
+}
+
+// unmountHostViewSubMounts tears down, deepest first, every mount the HOST
+// sees strictly below root that the container view does not also list. Same
+// depth-descending contract as unmountSubMounts: the kernel only accepts a
+// parent unmount once every child is gone. Entries the container table
+// already lists are skipped here -- unmounting the same mount through both
+// views is at best redundant, and the container sweep at the call site
+// handles them with their plain paths.
+func unmountHostViewSubMounts(ns *nodeServer, root string) error {
+	mounts, ok := hostViewMounts()
+	if !ok {
+		return nil
+	}
+	container, err := listProcMounts("/proc/mounts")
+	if err != nil {
+		// The container view is unexpectedly unreadable; the host sweep is
+		// still worth running, it just cannot dedupe against it.
+		container = nil
+	}
+	seen := make(map[string]bool, len(container))
+	for _, mp := range container {
+		seen[mp.Path] = true
+	}
+
+	prefix := root + "/"
+	var subs []string
+	for _, mp := range mounts {
+		if strings.HasPrefix(mp.Path, prefix) && !seen[mp.Path] {
+			subs = append(subs, mp.Path)
+		}
+	}
+	sort.SliceStable(subs, func(i, j int) bool {
+		return strings.Count(subs[i], "/") > strings.Count(subs[j], "/")
+	})
+
+	for _, p := range subs {
+		alias := hostPathAlias(p)
+		log.Infof("NodeUnpublishVolume: unmounting host-view sub-mount %s (alias %s, under %s)", p, alias, root)
+		if err := ns.Mounter.Interface.Unmount(alias); err != nil {
+			return fmt.Errorf("unmount host-view sub-mount %s: %w", p, err)
+		}
+	}
+	return nil
+}
+
+// peelHostAliasMount brings a mount down through its /host alias when the
+// host still holds it, regardless of what the container view renders.
+// Bounded like the container peel, and the teardown is verified against the
+// host table itself -- an unmount that did not detach is an error, never a
+// reported success.
+func peelHostAliasMount(ns *nodeServer, targetPath string) error {
+	alias := hostPathAlias(targetPath)
+	for i := 0; i < maxUnmountPeels; i++ {
+		mounted, ok := stillMountedInHostView(targetPath)
+		if !ok || !mounted {
+			return nil
+		}
+		if i == 0 {
+			log.Infof("%s is mounted on the host but hidden from the container view; unmounting via %s", targetPath, alias)
+		}
+		if err := ns.Mounter.Interface.Unmount(alias); err != nil {
+			return fmt.Errorf("failed to unmount %s through %s: %v", targetPath, alias, err)
+		}
+	}
+	if mounted, ok := stillMountedInHostView(targetPath); ok && mounted {
+		return fmt.Errorf("%s is still mounted in the host view after %d alias unmount attempts (%s)",
+			targetPath, maxUnmountPeels, alias)
+	}
+	return nil
+}
+
 // maxUnmountPeels bounds the stacked-bind teardown of one call; kubelet
 // retries NodeUnpublishVolume if layers remain.
 const maxUnmountPeels = 10
@@ -1326,6 +1462,14 @@ func (ns *nodeServer) NodeUnpublishVolume(ctx context.Context, req *csi.NodeUnpu
 		return nil, status.Errorf(codes.Internal, "Failed to unmount sub-mounts under %s: %v", targetPath, err)
 	}
 
+	// The container view can miss sub-mounts the host still sees (mounts
+	// that never propagated into this plugin pod). Sweep the host table
+	// too, through the /host alias, and skip entries the container sweep
+	// already handled.
+	if err := unmountHostViewSubMounts(ns, targetPath); err != nil {
+		return nil, status.Errorf(codes.Internal, "Failed to unmount host-view sub-mounts under %s: %v", targetPath, err)
+	}
+
 	for i := 0; i < maxUnmountPeels; i++ {
 		mounted, err := isStillMounted(ns.Mounter.Interface, targetPath)
 		if err != nil {
@@ -1345,8 +1489,29 @@ func (ns *nodeServer) NodeUnpublishVolume(ctx context.Context, req *csi.NodeUnpu
 		return nil, status.Errorf(codes.Internal, "%s is still mounted after %d unmount attempts", targetPath, maxUnmountPeels)
 	}
 
+	// A mount can survive the container-side peel only in the host view: the
+	// container table renders its kubelet path through the /host bind only,
+	// or not at all, so the plain unmounts above were no-ops. Bridge through
+	// the alias and verify against the host table before calling this done.
+	if err := peelHostAliasMount(ns, targetPath); err != nil {
+		return nil, status.Errorf(codes.Internal, "%v", err)
+	}
+
 	if err := os.Remove(targetPath); err != nil && !os.IsNotExist(err) {
-		if errors.Is(err, unix.ENOTEMPTY) || errors.Is(err, unix.EEXIST) {
+		if errors.Is(err, unix.EBUSY) {
+			// The rmdir can trip over a mount the current view does not
+			// render (a dead pod's mount the host still holds). Peel through
+			// the alias once more and retry instead of failing the kubelet
+			// with an error only the next full unpublish could clear.
+			log.Infof("NodeUnpublishVolume: os.Remove %s hit EBUSY, re-peeling through the host view", targetPath)
+			if perr := peelHostAliasMount(ns, targetPath); perr != nil {
+				return nil, status.Errorf(codes.Internal, "Failed to remove target path: %v (and the host-view peel did not clear it: %v)", err, perr)
+			}
+			if rerr := os.Remove(targetPath); rerr != nil && !os.IsNotExist(rerr) {
+				return nil, status.Errorf(codes.Internal, "Failed to remove target path: %v", rerr)
+			}
+			return &csi.NodeUnpublishVolumeResponse{}, nil
+		} else if errors.Is(err, unix.ENOTEMPTY) || errors.Is(err, unix.EEXIST) {
 			// The sub-mount sweep above handled every live mount we could
 			// see in /proc/mounts, but leftover non-mount content (stale
 			// files from a container that wrote into a vanished bind mount,

+				return hostTable, nil
+			}
+			return nil, nil
+		})
+		fm := mount.NewFakeMounter([]mount.MountPoint{{Device: "/dev/sdc", Path: hostRootAlias + target, Opts: []string{"rw"}}})
+		calls := 0
+		fm.UnmountFunc = func(string) error {
+			calls++
+			// Surviving mount: the fake kernel keeps it in place.
+			fm.MountPoints = append(fm.MountPoints, mount.MountPoint{Device: "/dev/sdc", Path: hostRootAlias + target, Opts: []string{"rw"}})
+			return nil
+		}
+		ns := &nodeServer{Mounter: &mount.SafeFormatAndMount{Interface: fm}}
+		err := peelHostAliasMount(ns, target)
+		if err == nil || !strings.Contains(err.Error(), "still mounted in the host view") {
+			t.Errorf("want refusal for a surviving mount, got %v", err)
+		}
+		if calls < 1 || calls > maxUnmountPeels {
+			t.Errorf("calls = %d, want 1..%d", calls, maxUnmountPeels)

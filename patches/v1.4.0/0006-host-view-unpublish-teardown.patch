+// TestPeelHostAliasMount verifies the helper in isolation: no-op on a clear
+// or unreadable host view, bounded refusal when the mount survives.
+func TestPeelHostAliasMount(t *testing.T) {
+	t.Run("no-op when host view is clear", func(t *testing.T) {
+		withHostViewFakes(t, "/host/proc/mounts-fake", func(which string) ([]mount.MountPoint, error) {
+			return nil, nil
+		})
+		fm := mount.NewFakeMounter(nil)
+		ns := &nodeServer{Mounter: &mount.SafeFormatAndMount{Interface: fm}}
+		if err := peelHostAliasMount(ns, "/tmp/whatever/mount"); err != nil {
+			t.Errorf("peelHostAliasMount on a clear host view: %v", err)
+		}
+	})
+	t.Run("no-op when host view unreadable", func(t *testing.T) {
+		withHostViewFakes(t, "/host/proc/mounts-absent", func(which string) ([]mount.MountPoint, error) {

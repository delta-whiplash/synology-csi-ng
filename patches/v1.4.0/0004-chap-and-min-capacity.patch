+	params.Add("auth_type", "1")
+	params.Add("chap_user", chapUser)
+	params.Add("chap_pass", chapPass)
+
+	resp, err := dsm.sendRequest("", &struct{}{}, params, "webapi/entry.cgi")
+	if err != nil {
+		return errCodeMapping(resp.ErrorCode, err)
+	}
+
+	return nil
+}

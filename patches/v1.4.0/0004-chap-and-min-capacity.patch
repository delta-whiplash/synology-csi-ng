+// TestControllerPublishVolume_WithChapSecrets verifies that when CHAP credentials
+// are provided in the secrets, ControllerPublishVolume calls SetTargetAuth on the
+// DSM service with the correct arguments.
+func TestControllerPublishVolume_WithChapSecrets(t *testing.T) {
+	mockService := &mockDsmServiceForChap{
+		volumes: map[string]*models.K8sVolumeRespSpec{
+			"vol-123": {
+				VolumeId: "vol-123",
+				DsmIp:    "10.0.0.1",
+				Target: webapi.TargetInfo{
+					TargetId: 456,
+				},
+			},
+		},
+	}
+
+	cs := &controllerServer{
+		dsmService: mockService,
+	}
+
+	req := &csi.ControllerPublishVolumeRequest{
+		VolumeId: "vol-123",
+		NodeId:   "node-1",
+		Secrets: map[string]string{
+			"chapUser":     "myuser",
+			"chapPassword": "mypassword",
+		},
+	}
+
+	_, err := cs.ControllerPublishVolume(context.Background(), req)
+	if err != nil {
+		t.Fatalf("ControllerPublishVolume returned error: %v", err)
+	}
+
+	if !mockService.setTargetAuthCalled {
+		t.Fatal("expected SetTargetAuth to be called when CHAP secrets are present")
+	}
+	if mockService.setTargetAuthDsmIp != "10.0.0.1" {
+		t.Errorf("dsmIp = %q, want %q", mockService.setTargetAuthDsmIp, "10.0.0.1")
+	}
+	if mockService.setTargetAuthTarget != "456" {
+		t.Errorf("target_id = %q, want %q", mockService.setTargetAuthTarget, "456")
+	}
+	if mockService.setTargetAuthUser != "myuser" {
+		t.Errorf("chap_user = %q, want %q", mockService.setTargetAuthUser, "myuser")
+	}
+	if mockService.setTargetAuthPass != "mypassword" {
+		t.Errorf("chap_pass = %q, want %q", mockService.setTargetAuthPass, "mypassword")
+	}
+}
+
+// TestControllerPublishVolume_WithoutSecrets verifies that when no CHAP secrets
+// are provided, ControllerPublishVolume does not call SetTargetAuth (backward
+// compatible behavior: the target keeps its existing auth setting).
+func TestControllerPublishVolume_WithoutSecrets(t *testing.T) {
+	mockService := &mockDsmServiceForChap{
+		volumes: map[string]*models.K8sVolumeRespSpec{
+			"vol-456": {
+				VolumeId: "vol-456",
+				DsmIp:    "10.0.0.2",
+				Target: webapi.TargetInfo{
+					TargetId: 789,
+				},
+			},
+		},
+	}
+
+	cs := &controllerServer{
+		dsmService: mockService,
+	}
+
+	req := &csi.ControllerPublishVolumeRequest{
+		VolumeId: "vol-456",
+		NodeId:   "node-1",
+		Secrets:  map[string]string{},
+	}
+
+	_, err := cs.ControllerPublishVolume(context.Background(), req)
+	if err != nil {
+		t.Fatalf("ControllerPublishVolume returned error: %v", err)
+	}
+
+	if mockService.setTargetAuthCalled {
+		t.Error("expected SetTargetAuth NOT to be called when no CHAP secrets are present")
+	}
+}

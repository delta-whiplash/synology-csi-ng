+// SetTargetAuth configures CHAP authentication on an iSCSI target hosted on the
+// DSM at dsmIp. It wraps webapi.DSM.TargetSetAuth so callers (typically the
+// controller server) do not need to resolve the DSM handle themselves.
+func (service *DsmService) SetTargetAuth(dsmIp string, targetId string, chapUser string, chapPass string) error {
+	dsm, err := service.GetDsm(dsmIp)
+	if err != nil {
+		return fmt.Errorf("failed to get DSM [%s] for CHAP auth: %v", dsmIp, err)
+	}
+	if err := dsm.TargetSetAuth(targetId, chapUser, chapPass); err != nil {
+		return fmt.Errorf("failed to set CHAP auth on target [%s]: %v", targetId, err)
+	}
+	return nil
+}
